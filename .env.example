# ─── Required: Coinflow Merchant Config ───────────────────────────────────────
# Your merchant ID from the Coinflow dashboard
NEXT_PUBLIC_COINFLOW_MERCHANT_ID=your-merchant-id

# Server-side only API key for card-on-file top-up calls
COINFLOW_API_KEY=your-api-key

# Coinflow environment: sandbox | staging | prod
NEXT_PUBLIC_COINFLOW_ENV=sandbox

# Credits contract "credit seed" configured in your Coinflow dashboard (often "cfusd")
NEXT_PUBLIC_COINFLOW_CREDIT_SEED=cfusd

# ─── Required: WalletConnect ──────────────────────────────────────────────────
# Get a free project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ─── Optional: RPC URLs ───────────────────────────────────────────────────────
# Defaults to public endpoints if not set (may be rate-limited in production)
NEXT_PUBLIC_POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
